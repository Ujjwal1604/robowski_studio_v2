# Robowski Studio Configuration Template
# Copy to .env (never commit real secrets or personal hostnames)

# Frontend (Vite): optional default URL for your Personal Lab PC backend
# Example: https://your-pc.tailnet-name.ts.net or http://192.168.1.50:8000
VITE_ROBOWSKI_BACKEND_URL=

# Personal Lab PC Backend (python_backend/app.py)
# Shared secret between Personal Lab PC and Robot PC helper (REQUIRED for live relay)
# Generate a strong random string (e.g., 24+ characters) and put the same value
# in relay_token.txt next to robot_pc_agent.py on the Robot PC.
ROBOWSKI_RELAY_TOKEN=

# Live hardware control PIN (recommended 6+ characters; required before any live robot move)
# Alternatively, store this in python_backend/robot_pin.txt on the Personal Lab PC.
ROBOWSKI_CONTROL_PIN=

# Comma-separated allowed browser origins for CORS (set to your app URL when exposing publicly)
ROBOWSKI_ALLOWED_ORIGINS=*

# Robot PC Helper (python_backend/robot_pc_agent.py)
# URL of your Personal Lab PC backend (or place it in python_backend/server_url.txt)
ROBOWSKI_BACKEND_URL=
