+import React from 'react';
+import { EdgeFit, EdgePick, EdgeSetting, edgeActive, edgeGain, edgeSuggestion } from '../../engine/tlcEdge';
+
+interface Props {
+  fits: (EdgeFit | null)[]; // one per half (lanes 0-26, lanes 27-53)
+  settings: EdgeSetting[];
+  onSetting: (half: number, s: EdgeSetting) => void;
+  picks: EdgePick[];
+  pickMode: boolean;
+  onPickMode: (on: boolean) => void;
+  pickGroup: number;
+  onPickGroup: (g: number) => void;
+  onClearPicks: () => void;
+}
+
+const PICK_COLORS = ['#f59e0b', '#22c55e', '#a855f7', '#ef4444', '#06b6d4', '#eab308'];
+
+const HALF_NAME = ['Lanes 0–26', 'Lanes 27–53'];
+
+function Diagnostic({ fit, strength }: { fit: EdgeFit; strength: number }) {
+  const w = 190, h = 56, pad = 4;
+  const ys = fit.used.map((p) => p.y);
+  const lim = Math.max(0.03, ...ys.map(Math.abs), fit.maxShift);
+  const X = (u: number) => pad + ((u + 1) / 2) * (w - 2 * pad);
+  const Y = (v: number) => h / 2 - (v / lim) * (h / 2 - pad);
+  const path = Array.from({ length: 41 }, (_, i) => {
+    const u = -1 + i / 20;
+    return `${i ? 'L' : 'M'}${X(u).toFixed(1)},${Y(strength * (fit.c1 * u + fit.c2 * u * u)).toFixed(1)}`;
+  }).join('');
+  return (
+    <svg width={w} height={h} role="img" aria-label="Spot position against lane position, with the fitted curve" style={{ background: 'var(--soft)', borderRadius: 4, flex: '0 0 auto' }}>
+      <line x1={pad} x2={w - pad} y1={h / 2} y2={h / 2} stroke="var(--line)" />
+      {fit.used.map((p, i) => (
+        <circle key={i} cx={X(p.u)} cy={Y(p.y)} r={1.6} fill="var(--mut)" opacity={0.6} />
+      ))}
+      <path d={path} fill="none" stroke="#ec4899" strokeWidth={1.6} />
+    </svg>
+  );
+}
+
+export const TlcEdgePanel: React.FC<Props> = ({
+  fits,
+  settings,
+  onSetting,
+  picks,
+  pickMode,
+  onPickMode,
+  pickGroup,
+  onPickGroup,
+  onClearPicks,
+}) => {
+  const groups = Math.max(pickGroup + 1, ...picks.map((q) => q.group + 1), 1);
+  return (
+    <details style={{ fontSize: 12, border: '1px solid var(--line)', borderRadius: 6, padding: '4px 8px', background: 'var(--panel)' }}>
+      <summary style={{ cursor: 'pointer', fontWeight: 600 }}>
+        Edge-effect correction
+        {fits.some((f, h) => edgeActive(f, settings[h])) ? ' — on' : ' — off'}
+      </summary>
+      <div style={{ display: 'grid', gap: 8, marginTop: 8 }}>
+        <div style={{ display: 'flex', gap: 6, alignItems: 'center', flexWrap: 'wrap' }}>
+          <button type="button" className={`btn sm${pickMode ? ' pri' : ''}`} onClick={() => onPickMode(!pickMode)}>
+            {pickMode ? 'Picking spots… (click to stop)' : 'Pick same-compound spots'}
+          </button>
+          <span style={{ color: 'var(--mut)' }}>Compound:</span>
+          {Array.from({ length: groups }, (_, g) => (
+            <button
+              key={g}
+              type="button"
+              className="btn sm"
+              onClick={() => onPickGroup(g)}
+              aria-pressed={pickGroup === g}
+              style={{ borderColor: PICK_COLORS[g % PICK_COLORS.length], fontWeight: pickGroup === g ? 700 : 400, outline: pickGroup === g ? `2px solid ${PICK_COLORS[g % PICK_COLORS.length]}` : undefined }}
+              title={`Compound ${g + 1}`}
+            >
+              {g + 1} ({picks.filter((q) => q.group === g).length})
+            </button>
+          ))}
+          <button type="button" className="btn sm" onClick={() => onPickGroup(groups)} title="Start another compound">+ new</button>
+          {picks.length > 0 ? (
+            <button type="button" className="btn sm" onClick={onClearPicks}>Clear picks</button>
+          ) : null}
+        </div>
+        <div style={{ color: 'var(--mut)' }}>
+          {pickMode
+            ? 'In the Full plate view, click a detected spot to add it to the chosen compound; click it again to remove it. Pick the same compound in lanes near both edges and in the middle.'
+            : 'Pick spots that must have the same Rf (for example a starting material) and the correction is calculated from them.'}
+        </div>
+        {[0, 1].map((h) => {
+          const fit = fits[h];
+          const s = settings[h];
+          const active = edgeActive(fit, s);
+          return (
+            <div key={h} style={{ display: 'flex', gap: 10, alignItems: 'center', flexWrap: 'wrap' }}>
+              <div style={{ minWidth: 220, flex: '1 1 220px' }}>
+                <b>{HALF_NAME[h]}</b>{' '}
+                {!fit ? (
+                  <span style={{ color: 'var(--mut)' }}>no data</span>
+                ) : active ? (
+                  <span>
+                    corrected: edge lanes {((edgeGain(fit, fit.xmin, s.strength) - 1) * 100).toFixed(1)} % /{' '}
+                    {((edgeGain(fit, fit.xmax, s.strength) - 1) * 100).toFixed(1)} % ({fit.nClusters} compound group
+                    {fit.nClusters === 1 ? '' : 's'}, {fit.nSpots} spots, scatter {(fit.scatter * 100).toFixed(1)} %)
+                  </span>
+                ) : edgeSuggestion(fit, s) ? (
+                  <span style={{ color: 'var(--mut)' }}>
+                    suggestion only, not applied: edge lanes {((edgeGain(fit, fit.xmin) - 1) * 100).toFixed(1)} % /{' '}
+                    {((edgeGain(fit, fit.xmax) - 1) * 100).toFixed(1)} % from {fit.nClusters} compound groups. Pick same-compound
+                    spots to apply a measured correction, or use Force on.
+                  </span>
+                ) : (
+                  <span style={{ color: 'var(--mut)' }}>{s.mode === 'off' ? 'off' : `not applied. ${fit.reason}`}</span>
+                )}
+                {fit && fit.nSpots > 0 && !active && !edgeSuggestion(fit, s) && s.mode !== 'off' ? (
+                  <span style={{ color: 'var(--mut)' }}> Measured curve {(fit.maxShift * 100).toFixed(1)} % at most.</span>
+                ) : null}
+              </div>
+              <select
+                className="f"
+                value={s.mode}
+                onChange={(e) => onSetting(h, { ...s, mode: e.target.value as EdgeSetting['mode'] })}
+                aria-label={`${HALF_NAME[h]} edge correction mode`}
+              >
+                <option value="auto">Auto</option>
+                <option value="on">Force on</option>
+                <option value="off">Off</option>
+              </select>
+              <label style={{ display: 'inline-flex', gap: 4, alignItems: 'center' }}>
+                <span>Strength</span>
+                <input
+                  type="range"
+                  min={0}
+                  max={1}
+                  step={0.05}
+                  value={s.strength}
+                  onChange={(e) => onSetting(h, { ...s, strength: parseFloat(e.target.value) })}
+                  style={{ width: 70 }}
+                />
+                <span className="mono" style={{ minWidth: 30 }}>{Math.round(s.strength * 100)}%</span>
+              </label>
+              {fit && fit.used.length > 0 ? <Diagnostic fit={fit} strength={active ? s.strength : 1} /> : null}
+            </div>
+          );
+        })}
+        <div style={{ color: 'var(--mut)' }}>
+          Each half of the plate is fitted on its own from compounds that appear in many lanes. Raw Rf is kept next to the corrected Rf in the CSV.
+        </div>
+      </div>
+    </details>
+  );
+};
