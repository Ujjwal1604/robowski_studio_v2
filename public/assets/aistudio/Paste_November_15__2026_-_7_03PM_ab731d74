+    expect(stepIsAtomBalanced(['C7H6O', 'C6H7N'], ['C13H11N'])).toBe(true); // water not listed: only H and O move
+    expect(stepIsAtomBalanced(['C7H6O', 'C6H7N'], ['C12H11N'])).toBe(false); // carbon lost
+    expect(stepIsAtomBalanced(['C7H6O', 'C6H7N'], ['C13H12N2O'])).toBe(false); // nitrogen created
+    expect(stepIsAtomBalanced(['C11H20O4'], ['C7H12O4'])).toBe(false);
