+const COND = (o: Partial<WellConditionConfig> = {}): WellConditionConfig => ({
+  medium: 'auto',
+  additiveName: '',
+  additiveEquiv: 0,
+  additivePka: 0,
+  temperatureC: 25,
+  waterPct: 2,
+  solvent: 'DMSO',
+  equivBasis: 'limiting',
