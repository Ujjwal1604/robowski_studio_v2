+function matchesAny(rdkit: any, smiles: string, list: Array<[string, string]>): string | null {
+  let mol: any = null;
+  try {
+    mol = rdkit.get_mol(smiles);
+    if (!mol) return null;
+    for (const [label, sma] of list) {
+      const q = getTlcQuery(rdkit, `rx_${label}`, sma);
